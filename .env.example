TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token
TELEGRAM_ALLOWED_CHAT_IDS=123456789

IPPANEL_MODE=legacy
IPPANEL_BASE_URL=https://ippanel.boil.network
IPPANEL_ACCOUNT=your-boil-account@example.com
IPPANEL_PASSWORD=your-ippanel-password
IPPANEL_API_TARGETS_FILE=/etc/ippanelbot-api-targets.json
API_CHANGE_INITIAL_DELAY_SECONDS=5
API_CHANGE_POLL_INTERVAL_SECONDS=30
API_CHANGE_CONFIRM_TIMEOUT_SECONDS=300

DB_PATH=/var/lib/ippanelbot/ippanel_bot.sqlite3
POST_CHANGE_QUERY_DELAY_SECONDS=5
QUERY_CACHE_SECONDS=60
CHANGE_MAX_ATTEMPTS=5
CHANGE_RETRY_DELAY_SECONDS=60
TIMEZONE=Asia/Shanghai
POLL_TIMEOUT_SECONDS=5
PANEL_IMAGE_PATH=pic.png
LOG_LEVEL=INFO

DDNS_ENABLED=0
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
DDNS_TTL_SECONDS=60
DDNS_SYNC_AFTER_CHANGE=1

RELAY_SYNC_ENABLED=0
RELAY_SYNC_AFTER_CHANGE=1
